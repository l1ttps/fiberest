PORT=3278
APP_ENV=development  # development|production|test
APP_NAME=Fiberest

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=fiberest
DB_SSLMODE=disable  # disable|allow|prefer|require|verify-ca|verify-full
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_MAX_LIFETIME=1h
DB_LOG_LEVEL=silent  # silent|error|warn|info

# CORS (comma-separated or single value; dev defaults to * if unset)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=info  # debug|info|warn|error
LOG_FORMAT=text # text|json (defaults to json in production, text otherwise)

# Auth
SESSION_DURATION=168h
BCRYPT_COST=10  # 4..31
